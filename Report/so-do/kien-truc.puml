@startuml uml_architecture
' ===== CẤU HÌNH =====
!$DPI  = 400
!$FONT = 20
' ====================

skinparam dpi $DPI
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize $FONT
skinparam classFontSize $FONT
skinparam classAttributeFontSize $FONT
skinparam stereotypeFontSize $FONT
skinparam arrowFontSize $FONT

skinparam linetype polyline
skinparam nodesep 60
skinparam ranksep 90
skinparam shadowing false
skinparam roundCorner 8

skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #333333
skinparam classArrowColor #333333
skinparam classFontColor #111111
skinparam arrowColor #333333
skinparam noteBackgroundColor #FFF8DC
skinparam noteBorderColor #AA8800

top to bottom direction

' ==================== CLASSES ====================

class SettingsPanel <<MonoBehaviour>> {
  - leftSphere, rightSphere : SphereMeshGenerator
  - leftDisp, rightDisp : DisplacementControl
  - headMover : HeadMover
  - columns : int[]
  - displacementOn : bool
  + OnGUI()
}

class SphereMeshGenerator <<MonoBehaviour>> {
  + loSegments : int
  + laSegments : int
  + radius : float
  - Build() : Mesh
  + Rebuild(lo : int, la : int)
}

class DisplacementControl <<MonoBehaviour>> {
  - flatRadius : float
  - nearOrigin : float
  - farOrigin : float
  + SetDisplacement(on : bool)
}

class HeadMover <<MonoBehaviour>> {
  - moveSpeed : float
  - maxDistance : float
  - originPosition : Vector3
  + OffsetFromOrigin : Vector3 {readOnly}
  + ResetPosition()
}

class HeadController <<MonoBehaviour>> {
  - sensitivity : float
  - yaw : float
  - pitch : float
}

class FPSCounter <<MonoBehaviour>> {
  - updateInterval : float
  - fps : float
  - frameMs : float
  + OnGUI()
}

class Head <<GameObject>> {
}

class Camera <<Unity>> {
}

class SG_PanoDisplace <<Shader Graph>> {
  + ColorTex : Texture2D
  + DepthTex : Texture2D
  + _NearRadius : float
  + _FarRadius : float
}

' ==================== RELATIONSHIPS ====================

SettingsPanel "1" -down-> "2" SphereMeshGenerator : gọi Rebuild(lo, la)
SettingsPanel "1" -down-> "2" DisplacementControl : gọi SetDisplacement(on)
SettingsPanel -down-> HeadMover : gọi ResetPosition()\nđọc OffsetFromOrigin

DisplacementControl -down-> SG_PanoDisplace : đặt _NearRadius,\n_FarRadius
SphereMeshGenerator ..down.> SG_PanoDisplace : mesh dùng chung\nmaterial của shader

HeadController -down-> Head : xoay (yaw, pitch)
HeadMover -down-> Head : dịch vị trí
Head "1" *-down- "2" Camera : chứa

' Sắp xếp
SettingsPanel -[hidden]right- FPSCounter
HeadController -[hidden]right- HeadMover

@enduml